#!/usr/bin/env python3
import os
import pickle
import face_recognition

KNOWN_FACES_DIR = "known_faces"
OUTPUT = "encodings.pickle"

def main():
    known_encodings = []
    known_names     = []

    # Walk through each person’s folder
    for person_name in os.listdir(KNOWN_FACES_DIR):
        person_dir = os.path.join(KNOWN_FACES_DIR, person_name)
        if not os.path.isdir(person_dir):
            continue

        # Loop over images
        for img_name in os.listdir(person_dir):
            if not img_name.lower().endswith((".png", ".jpg", ".jpeg")):
                continue

            img_path = os.path.join(person_dir, img_name)
            image    = face_recognition.load_image_file(img_path)
            encs     = face_recognition.face_encodings(image)

            if len(encs) == 0:
                print(f"⚠️  No face found in {img_path}; skipping.")
                continue

            # We assume one face per training image
            known_encodings.append(encs[0])
            known_names.append(person_name)
            print(f"✔️  Encoded {person_name}/{img_name}")

    # Save to disk
    with open(OUTPUT, "wb") as f:
        pickle.dump({"encodings": known_encodings, "names": known_names}, f)
    print(f"\n✅  Saved {len(known_encodings)} encodings to {OUTPUT}")

if __name__ == "__main__":
    main()
