import cv2, sys, time

cap = cv2.VideoCapture("/dev/video0", cv2.CAP_V4L)  # use legacy V4L1 compat flag
if not cap.isOpened():
    sys.exit("ERROR: cannot open /dev/video0")

cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

print("[*] Press ESC to quit")
while True:
    ok, frame = cap.read()
    if not ok:
        time.sleep(0.05); continue
    cv2.imshow("Camera test", frame)
    if cv2.waitKey(1) == 27:
        break

cap.release()
cv2.destroyAllWindows()
