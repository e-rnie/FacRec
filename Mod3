#!/usr/bin/env python3
"""
Self‑contained LBPH face‑recognition on Raspberry Pi (Buster, OpenCV 3.2).

• Spawns libcamera‑vid → TCP 5001 (raw YUV420 frames)
• Spawns ffmpeg        → UDP 5000 (same raw bytes)
• Receives UDP, converts to BGR, runs LBPH, shows window

Press ESC to quit; both helper processes are cleaned up automatically.
"""

import cv2, numpy as np, socket, subprocess, time, pickle, os, signal, atexit, sys

WIDTH, HEIGHT = 640, 480
TCP_PORT   = 5001
UDP_PORT   = 5000

###############################################################################
# 1 — Start helper processes
###############################################################################
libcamera_cmd = [
    "libcamera-vid", "-t", "0",
    "--width", str(WIDTH), "--height", str(HEIGHT),
    "--codec", "yuv420",
    "-o", f"tcp://127.0.0.1:{TCP_PORT}"
]

ffmpeg_cmd = [
    "ffmpeg", "-loglevel", "warning",
    "-f", "rawvideo", "-pix_fmt", "yuv420p", "-s", f"{WIDTH}x{HEIGHT}",
    "-i", f"tcp://127.0.0.1:{TCP_PORT}",
    "-vcodec", "copy", "-f", "rawvideo", f"udp://127.0.0.1:{UDP_PORT}"
]

print("[*] Launching libcamera‑vid …")
cam_proc = subprocess.Popen(libcamera_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
time.sleep(2)                           # give camera a moment to initialise
print("[*] Launching ffmpeg relay …")
ffmpeg_proc = subprocess.Popen(ffmpeg_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def cleanup():
    for p in (ffmpeg_proc, cam_proc):
        try:
            p.send_signal(signal.SIGINT)
            p.wait(2)
        except Exception:
            pass
atexit.register(cleanup)

###############################################################################
# 2 — Load LBPH model and cascade
###############################################################################
rec = cv2.face.createLBPHFaceRecognizer()
rec.load("lbph.yml")
names = pickle.load(open("labels.pkl", "rb"))

CASCADE = "/usr/share/opencv/haarcascades/haarcascade_frontalface_default.xml"
detector = cv2.CascadeClassifier(CASCADE)

###############################################################################
# 3 — UDP receiver for raw frames
###############################################################################
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(("127.0.0.1", UDP_PORT))
sock.settimeout(2)

FRAME_SIZE = WIDTH * HEIGHT * 3 // 2     # YUV420

def get_frame():
    try:
        packet, _ = sock.recvfrom(FRAME_SIZE)
    except socket.timeout:
        return None
    if len(packet) != FRAME_SIZE:
        return None
    yuv = np.frombuffer(packet, dtype=np.uint8).reshape((HEIGHT * 3 // 2, WIDTH))
    return cv2.cvtColor(yuv, cv2.COLOR_YUV2BGR_I420)

###############################################################################
# 4 — Main loop
###############################################################################
print("[*] ESC to quit")
while True:
    frame = get_frame()
    if frame is None:
        continue

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    rects = detector.detectMultiScale(gray, 1.3, 5)

    for (x, y, w, h) in rects:
        roi = gray[y:y+h, x:x+w]
        label, conf = rec.predict(roi)
        name = names[label] if conf < 70 else "Unknown"
        cv2.rectangle(frame, (x, y), (x+w, y+h), (0,255,0), 2)
        cv2.putText(frame, f"{name} {conf:.0f}", (x, y-10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,255,0), 2)

    cv2.imshow("LBPH Face‑ID (libcamera)", frame)
    if cv2.waitKey(1) == 27:    # ESC
        break

###############################################################################
# 5 — Cleanup (via atexit)
###############################################################################
cv2.destroyAllWindows()
