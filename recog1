#!/usr/bin/env python3
import cv2
import face_recognition
import pickle
import numpy as np

# ————————————————
# Config
# ————————————————
ENCODINGS_FILE = "encodings.pickle"
CAM_WIDTH  = 320
CAM_HEIGHT = 240
TOLERANCE  = 0.5   # face distance threshold; lower = stricter match
MODEL      = "hog" # "hog" (CPU) or "cnn" (GPU if available)

# ————————————————
# Load Known Encodings
# ————————————————
data = pickle.load(open(ENCODINGS_FILE, "rb"))
# data["encodings"], data["names"]

# ————————————————
# Initialize Video Capture
# ————————————————
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  CAM_WIDTH)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAM_HEIGHT)
if not cap.isOpened():
    raise RuntimeError("Cannot open camera")

print("📹  Camera streaming at "
      f"{CAM_WIDTH}×{CAM_HEIGHT}. Press Q to quit.")

# ————————————————
# Main Loop
# ————————————————
while True:
    ret, frame = cap.read()
    if not ret:
        break

    # Convert BGR (OpenCV) → RGB (face_recognition)
    rgb_frame = frame[:, :, ::-1]

    # Find all faces and their encodings in THIS frame
    face_locations = face_recognition.face_locations(rgb_frame, model=MODEL)
    face_encodings = face_recognition.face_encodings(
        rgb_frame,
        known_face_locations=face_locations,
        num_jitters=1
    )

    # Loop through each detected face
    for (top, right, bottom, left), face_encoding in zip(face_locations, face_encodings):
        # Attempt to match against our known encodings
        matches = face_recognition.compare_faces(data["encodings"], face_encoding, TOLERANCE)
        name    = "Unknown"

        # If there’s at least one match, take the one with smallest distance
        if True in matches:
            distances   = face_recognition.face_distance(data["encodings"], face_encoding)
            best_index  = np.argmin(distances)
            name        = data["names"][best_index]

        # Draw a tight rectangle around the face
        cv2.rectangle(frame, (left, top), (right, bottom), (0, 255, 0), 2)
        # Draw the label
        cv2.putText(frame, name, (left, top - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,255,0), 2)

    # Show the result
    cv2.imshow("Face Recognition", frame)

    # Quit on ‘q’ key
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

# Cleanup
cap.release()
cv2.destroyAllWindows()

